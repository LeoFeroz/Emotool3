  <ItemGroup>
    <!-- Arquivos comuns: soltos direto em BuildExtra\, fora de qualquer
         subpasta Debug\/Release\. Vão para toda configuração. -->
    <BuildExtraFilesCommon Include="$(MSBuildProjectDirectory)\BuildExtra\*.*" />
    <!-- Arquivos específicos da configuração atual: só dentro de
         BuildExtra\$(Configuration)\. A pasta da OUTRA configuração
         (ex: Release\ enquanto builda Debug) nunca entra aqui. -->
    <BuildExtraFilesConfig Include="$(MSBuildProjectDirectory)\BuildExtra\$(Configuration)\**\*.*" Condition="Exists('$(MSBuildProjectDirectory)\BuildExtra\$(Configuration)')" />
  </ItemGroup>
  <Target Name="CopyRuntimeFiles" AfterTargets="Build">
    <Copy SourceFiles="$(FBXSDK_DIR)\lib\x64\$(Configuration)\libfbxsdk.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('$(FBXSDK_DIR)\lib\x64\$(Configuration)\libfbxsdk.dll')" />
    <!-- Fallback: se não existir uma libfbxsdk.dll de Debug separada (comum,
         já que o FBX SDK normalmente só distribui a DLL de Release), usa a
         de Release mesmo em builds Debug. -->
    <Copy SourceFiles="$(FBXSDK_DIR)\lib\x64\Release\libfbxsdk.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="'$(Configuration)'=='Debug' AND !Exists('$(FBXSDK_DIR)\lib\x64\Debug\libfbxsdk.dll')" />
    <Copy SourceFiles="@(BuildExtraFilesCommon)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(BuildExtraFilesConfig)" DestinationFiles="@(BuildExtraFilesConfig->'$(TargetDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
